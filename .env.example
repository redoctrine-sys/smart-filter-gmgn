# ============================================================
# GMGN Agent API
# ============================================================
# Generate keys: see https://docs.gmgn.ai/index/gmgn-agent-api
# Public test key (read-only): gmgn_solbscbaseethmonadtron
GMGN_API_KEY=
GMGN_PRIVATE_KEY=
GMGN_BASE_URL=https://gmgn.ai/api

# ============================================================
# Telegram
# ============================================================
TELEGRAM_BOT_TOKEN=
# Set after running /setup in your supergroup. Auto-filled if you let
# the bot detect it (or paste from runtime log).
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_BEFORE_MIGRATED=
TELEGRAM_TOPIC_AFTER_MIGRATED=
TELEGRAM_TOPIC_SLEEPER=
TELEGRAM_TOPIC_POST_ALERT=

# ============================================================
# Trojan + Jupiter (alert action buttons)
# ============================================================
TROJAN_REFCODE=
JUPITER_BASE_URL=https://jup.ag/swap/SOL-

# ============================================================
# Gemini (Sleeper narrative scoring)
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# Pipelines
# ============================================================
# Three categories now: before_migrated (Pump.fun bonding chaos),
# after_migrated (Raydium reversal sweet spot), sleeper (low-cap slowcook).
BEFORE_MIGRATED_POLL_MS=4000
AFTER_MIGRATED_POLL_MS=8000
SLEEPER_POLL_MS=60000
# Tokens older than this (since launch) are no longer considered for the
# after_migrated pipeline — they belong to sleeper / out-of-scope.
AFTER_MIGRATED_MAX_AGE_HOURS=6
POST_ALERT_POLL_MS=5000
POST_ALERT_ESCALATE_AFTER_HOURS=6
POST_ALERT_ESCALATED_POLL_MS=60000
POST_ALERT_LIFECYCLE_HOURS=24

# ============================================================
# Adaptive rate limiter
# ============================================================
GMGN_INITIAL_RPS=4
GMGN_MIN_RPS=0.5
GMGN_MAX_RPS=10
GMGN_BACKOFF_FACTOR=0.5
GMGN_RECOVER_FACTOR=1.1

# ============================================================
# Backtester / digest
# ============================================================
# Daily digest fires at 08:00 Asia/Jakarta. Window = trailing 24h.
# Almost-triggered band = scores within (threshold - N) .. (threshold - 1).
BACKTEST_ALMOST_BAND=15
# Score-weighted sizing: size_sol = clamp(score/threshold, 0.5, 2.5) * BASE.
BACKTEST_BASE_SIZE_SOL=1.0
# Snapshot retention (older rows pruned periodically).
BACKTEST_RETENTION_DAYS=30

# ============================================================
# Narrative cluster + copycat (New Pair)
# ============================================================
# How far back to look for similar tokens when deciding "OLDEST in cluster".
CLUSTER_LOOKBACK_HOURS=6
# How far back to scan for runners (tokens that pumped >= MULTIPLIER x).
RUNNER_LOOKBACK_HOURS=24
RUNNER_MIN_MULTIPLIER=3.0
# Jaccard threshold (0..1) above which two tokens are considered similar.
COPYCAT_SIMILARITY_THRESHOLD=0.5

# ============================================================
# Misc
# ============================================================
LOG_LEVEL=info
DB_PATH=./data/state.db
TEMPLATE_BEFORE_MIGRATED=./templates/before_migrated_irisan.yaml
TEMPLATE_AFTER_MIGRATED=./templates/after_migrated_irisan.yaml
TEMPLATE_SLEEPER=./templates/sleeper_irisan.yaml
SMART_MONEY_CSV=./data/smart_money_wallets.csv
